NORBOT_DATABASE_URL=postgres://norbot:norbot@postgres:5432/norbot?sslmode=disable
NORBOT_HTTP_ADDR=0.0.0.0:8080
NORBOT_ALLOW_UNAUTHENTICATED_LOCAL=true
NORBOT_ARTIFACTS_DIR=/var/lib/norbot/artifacts
NORBOT_CONFIG=/etc/norbot/config.json
NORBOT_OTEL_ENDPOINT=otel-collector:4318
NORBOT_WORKERS=2
NORBOT_MAX_WORKERS=4
NORBOT_DOCKER_BIN=docker
NORBOT_CONFIG_HOST=./config.json
NORBOT_KUBECONFIG_HOST=./deploy/empty-kubeconfig
NORBOT_EGRESS_PROXY_SECRET=
NORBOT_S3_ACCESS_KEY=
NORBOT_S3_SECRET_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
