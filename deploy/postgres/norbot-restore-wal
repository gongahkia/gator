#!/bin/sh
set -eu

segment="${1:?postgres WAL segment required}"
destination="${2:?postgres WAL destination required}"
: "${NORBOT_WAL_ARCHIVE_DIR:?set NORBOT_WAL_ARCHIVE_DIR}"
: "${NORBOT_BACKUP_PASSPHRASE:?set NORBOT_BACKUP_PASSPHRASE}"
GNUPGHOME="${GNUPGHOME:-/tmp/norbot-gnupg}"
export GNUPGHOME
mkdir -p "$GNUPGHOME"
chmod 700 "$GNUPGHOME"
case "$segment" in *[!A-Za-z0-9.]*) exit 2;; esac
source="$NORBOT_WAL_ARCHIVE_DIR/$segment.enc"
[ -f "$source" ] || exit 1
printf '%s' "$NORBOT_BACKUP_PASSPHRASE" | gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 --decrypt --output "$destination" "$source"
