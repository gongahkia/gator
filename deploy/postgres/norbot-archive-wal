#!/bin/sh
set -eu

source="${1:?postgres archive source required}"
segment="${2:?postgres WAL segment required}"
: "${NORBOT_WAL_ARCHIVE_DIR:?set NORBOT_WAL_ARCHIVE_DIR}"
: "${NORBOT_BACKUP_PASSPHRASE:?set NORBOT_BACKUP_PASSPHRASE}"
GNUPGHOME="${GNUPGHOME:-/tmp/norbot-gnupg}"
export GNUPGHOME
mkdir -p "$GNUPGHOME"
chmod 700 "$GNUPGHOME"
case "$segment" in *[!A-Za-z0-9.]*) exit 2;; esac
mkdir -p "$NORBOT_WAL_ARCHIVE_DIR"
target="$NORBOT_WAL_ARCHIVE_DIR/$segment.enc"
if [ -f "$target" ]; then
  printf '%s' "$NORBOT_BACKUP_PASSPHRASE" | gpg --batch --quiet --yes --pinentry-mode loopback --passphrase-fd 0 --decrypt "$target" >/dev/null && exit 0
  echo "existing WAL archive is invalid: $segment" >&2
  exit 1
fi
temporary="$target.$$.tmp"
trap 'rm -f "$temporary"' EXIT HUP INT TERM
printf '%s' "$NORBOT_BACKUP_PASSPHRASE" | gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 --symmetric --cipher-algo AES256 --output "$temporary" "$source"
chmod 600 "$temporary"
mv "$temporary" "$target"
