{
  "providers": [
    {
      "id": "openai",
      "kind": "openai_responses",
      "model": "gpt-5",
      "base_url": "https://api.openai.com/v1",
      "credential_env": "OPENAI_API_KEY",
      "budget": {"max_concurrent": 2, "requests_per_minute": 60},
      "stages": ["planner", "builder", "verifier"]
    },
    {
      "id": "anthropic",
      "kind": "anthropic_messages",
      "model": "claude-sonnet-4-6",
      "base_url": "https://api.anthropic.com",
      "credential_env": "ANTHROPIC_API_KEY",
      "budget": {"max_concurrent": 2, "requests_per_minute": 50},
      "stages": ["planner", "builder", "verifier"]
    },
    {
      "id": "gemini",
      "kind": "gemini_generate_content",
      "model": "gemini-3.6-flash",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "credential_env": "GEMINI_API_KEY",
      "budget": {"max_concurrent": 2, "requests_per_minute": 60},
      "stages": ["planner", "builder", "verifier"]
    },
    {
      "id": "codex",
      "kind": "cli",
      "image": "ghcr.io/openai/codex:latest",
      "network": "bridge",
      "credential_env": "OPENAI_API_KEY",
      "budget": {"max_concurrent": 1, "requests_per_minute": 20},
      "command": ["codex", "exec", "--json"],
      "stages": ["planner", "builder", "verifier"]
    }
  ],
  "profiles": ["frontend-only", "full-stack", "agentic"],
  "tool_policy": {
    "artifact_read": {"enabled": true, "approval_required": false, "roles": ["researcher", "builder"]},
    "http_get": {"enabled": true, "approval_required": false, "roles": ["researcher"], "allowed_hosts": ["api.example.com"]},
    "http_write": {"enabled": true, "approval_required": true, "roles": ["operator"]},
    "database_mutate": {"enabled": true, "approval_required": true, "roles": ["operator"]},
    "file_write": {"enabled": true, "approval_required": true, "roles": ["operator"]},
    "shell": {"enabled": false, "approval_required": true, "roles": ["operator"], "allowed_commands": []}
  },
  "plugins": [],
  "workflow": {"max_fixes": 2},
  "security": {
    "oidc": {"issuer": "https://issuer.example.com", "audience": "norbot", "groups_claim": "groups", "operator_groups": ["norbot-operators"]}
  },
  "artifacts": {
    "endpoint": "https://s3.example.com", "region": "us-east-1", "bucket": "norbot-artifacts", "access_key_env": "NORBOT_S3_ACCESS_KEY", "secret_key_env": "NORBOT_S3_SECRET_KEY", "force_path_style": true
  },
  "runtime": {
    "default_target": "docker",
    "sandbox": {"image": "alpine:3.21", "cpu_milli": 500, "memory_mib": 512, "timeout_seconds": 60, "egress_proxy_url": "http://host.docker.internal:8181", "egress_proxy_secret_env": "NORBOT_EGRESS_PROXY_SECRET"},
    "kubernetes": {
      "kubeconfig": "/absolute/path/to/kubeconfig",
      "context": "",
      "namespace": "norbot",
      "service_account": "norbot-runtime",
      "registry_repository": "registry.example.com/norbot",
      "registry_pull_secret": "registry-pull",
      "ingress_class": "",
      "ingress_base_domain": "",
      "ingress_controller_namespace": "",
      "cpu_milli": 500,
      "memory_mib": 512,
      "replicas": 1
    }
  }
}
