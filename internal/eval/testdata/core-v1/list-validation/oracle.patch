--- a/parser/list.go
+++ b/parser/list.go
@@ -1,14 +1,22 @@
 package parser
 
-import "strings"
+import (
+	"errors"
+	"strings"
+)
 
 // ParseList splits a comma-separated list and normalizes whitespace.
 func ParseList(input string) ([]string, error) {
+	if strings.TrimSpace(input) == "" {
+		return nil, errors.New("list must contain at least one item")
+	}
 	var values []string
 	for _, item := range strings.Split(input, ",") {
-		if item = strings.TrimSpace(item); item != "" {
-			values = append(values, item)
+		item = strings.TrimSpace(item)
+		if item == "" {
+			return nil, errors.New("list contains an empty item")
 		}
+		values = append(values, item)
 	}
 	return values, nil
 }
