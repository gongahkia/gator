  "cases": [
    {
      "id": "vendor-choice",
      "family": "research",
      "split": "development",
      "source": "sources/vendor-choice",
      "objective": "Using the selected procurement requirements and quotes, choose the vendor that meets both requirements. Write decision.json with recommended_vendor, atlas_first_month_usd, beacon_first_month_usd, atlas_lead_days, beacon_eligible, source_for_atlas, and a brief reason. Use two decimal places for USD values and the quote that explicitly supersedes the old one.",
      "contract": {
        "version": 1,
        "artifacts": [
          {
            "path": "decision.json",
            "validations": [
              {
                "kind": "artifact_exists"
              },
              {
                "kind": "non_empty"
              },
              {
                "kind": "json"
              }
            ]
          }
        ],
        "external_actions": "forbid",
        "max_artifact_bytes": 33554432,
        "max_total_bytes": 134217728
      },
      "mode": "draft",
      "max_steps": 24,
      "limits": {
        "model_requests": 64,
        "wall_seconds": 180
      },
      "code": {},
      "capabilities": [],
      "script": [
        {
          "tool_calls": [
            {
              "id": "read-0",
              "name": "read_file",
              "arguments": {
                "path": "source/requirements.md"
              }
            },
            {
              "id": "read-1",
              "name": "read_file",
              "arguments": {
                "path": "source/atlas-2026-10-01.md"
              }
            },
            {
              "id": "read-2",
              "name": "read_file",
              "arguments": {
                "path": "source/atlas-2026-10-12.md"
              }
            },
            {
              "id": "read-3",
              "name": "read_file",
              "arguments": {
                "path": "source/beacon-2026-10-10.md"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "id": "write_json_artifact",
              "name": "write_json_artifact",
              "arguments": {
                "path": "decision.json",
                "value": {
                  "recommended_vendor": "Atlas",
                  "atlas_first_month_usd": "1850.00",
                  "beacon_first_month_usd": "2050.00",
                  "atlas_lead_days": 9,
                  "beacon_eligible": false,
                  "source_for_atlas": "source/atlas-2026-10-12.md",
                  "reason": "Atlas meets both requirements. Beacon exceeds the first-month budget."
                }
              }
            }
          ]
        },
        {
          "text": "Prepared the requested output."
        }
      ],
      "graders": [
        {
          "version": 1,
          "kind": "json_pointer_equals",
          "path": "decision.json",
          "locator": "/recommended_vendor",
          "expected": "\"Atlas\""
        },
        {
          "version": 1,
          "kind": "json_pointer_equals",
          "path": "decision.json",
          "locator": "/atlas_first_month_usd",
          "expected": "\"1850.00\""
        },
        {
          "version": 1,
          "kind": "json_pointer_equals",
          "path": "decision.json",
          "locator": "/beacon_first_month_usd",
          "expected": "\"2050.00\""
        },
        {
          "version": 1,
          "kind": "json_pointer_equals",
          "path": "decision.json",
          "locator": "/atlas_lead_days",
          "expected": "9"
        },
        {
          "version": 1,
          "kind": "json_pointer_equals",
          "path": "decision.json",
          "locator": "/beacon_eligible",
          "expected": "false"
        },
        {
          "version": 1,
          "kind": "json_pointer_equals",
          "path": "decision.json",
          "locator": "/source_for_atlas",
          "expected": "\"source/atlas-2026-10-12.md\""
        }
      ]
    },
