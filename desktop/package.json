{
  "name": "gator-desktop",
  "productName": "Gator",
  "version": "0.1.0",
  "description": "Gator personal agent desktop application",
  "author": "Gabriel Ong",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:ui": "node scripts/collect-licenses.mjs && vite build",
    "build": "npm run build:runtime && npm run build:ui",
    "start": "npm run build && electron .",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && npm test --prefix ../app-host",
    "test:e2e": "playwright test",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "lucide-react": "1.60.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "@gator/application-host": "file:../app-host"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "fflate": "0.8.3",
    "@xmldom/xmldom": "0.9.12"
  },
  "build": {
    "appId": "com.gongahkia.gator",
    "asar": true,
    "artifactName": "Gator-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "licenses/**/*",
      "package.json",
      "!**/*.test.mjs"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "gator-runtime",
          "gator-runtime.exe"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Gator uses the microphone only when you start dictation. Recorded audio is sent to your selected voice provider for transcription."
      }
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "beforePack": "./scripts/check-runtime.cjs",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": false,
      "include": "build/installer.nsh"
    }
  }
}
