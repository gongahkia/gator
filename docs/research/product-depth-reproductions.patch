+package snapshot
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestAuditSameContentOverwritesSourceIdentity(t *testing.T) {
+	state, a, b := t.TempDir(), t.TempDir(), t.TempDir()
+	for _, dir := range []string{a, b} {
+		if err := os.WriteFile(filepath.Join(dir, "notes.txt"), []byte("identical"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	x, err := Create(a, state, Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	y, err := Create(b, state, Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if x.ID != y.ID {
+		t.Fatal("expected identical content IDs")
+	}
+	z, err := Open(state, x.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if z.SourcePath != b {
+		t.Fatal("unexpected origin")
+	}
+	t.Log("reproduced: opening first snapshot now reports the second source directory")
+}
+
+func TestAuditSnapshotOmitsCodeConfiguration(t *testing.T) {
+	source, state := t.TempDir(), t.TempDir()
+	if err := os.Mkdir(filepath.Join(source, ".gator"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(source, ".gator", "agents.json"), []byte(`{"version":1,"profiles":[]}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	x, err := Create(source, state, Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(x.Materialized, ".gator", "agents.json")); !os.IsNotExist(err) {
+		t.Fatalf("expected missing project configuration: %v", err)
+	}
+	t.Log("reproduced: source snapshots exclude .gator project configuration")
+}
